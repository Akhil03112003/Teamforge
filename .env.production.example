# Inject through the deployment secret manager. Never commit a populated copy.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://replace-with-database-host:5432/teamforge?sslmode=verify-full&sslrootcert=/run/secrets/postgres-ca.crt
DB_USERNAME=replace_with_application_role
DB_PASSWORD=replace_with_secret_manager_value
DB_POOL_MAX=10
PORT=8080
# Optional dedicated migration role; defaults inherit DB_* for local compatibility.
# Production: supply these using a DDL role and keep DB_USERNAME a non-owner DML role,
# or apply migrations in a separate release step and disable runtime Flyway.
FLYWAY_DB_URL=jdbc:postgresql://replace-with-database-host:5432/teamforge?sslmode=verify-full&sslrootcert=/run/secrets/postgres-ca.crt
FLYWAY_DB_USERNAME=replace_with_migration_role
FLYWAY_DB_PASSWORD=replace_with_migration_secret
# The TLS edge must use this same origin, disable SSE buffering, and apply request limits.
# Do not activate local or disable Secure/HttpOnly cookies in production.
# Only after reviewing actual ingress peer IPs, use SPRING_PROFILES_ACTIVE=prod,proxy
# TRUSTED_PROXY_REGEX=replace_with_anchored_regex_for_immediate_proxy_peers
# The proxy must overwrite all client-supplied forwarding headers; origin must be private.
