# Copy to ignored .env.benchmark. Keep database credentials private; never target production.
# Use only synthetic participant credentials, never real participant passwords.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=replace_with_local_database_owner
PGPASSWORD=replace_with_local_database_password
PGDATABASE=teamforge_benchmark_m8a
# Optional alternative: existing database name above plus a NEW isolated schema below.
# PGSCHEMA=teamforge_benchmark_m8a
BENCHMARK_PASSWORD=replace_with_synthetic_password_at_least_12_characters
BASE_URL=http://127.0.0.1:8082
